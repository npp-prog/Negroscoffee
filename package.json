{
  "name": "kape-negros",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --remote --schema public > lib/db/types.ts && prettier --write lib/db/types.ts",
    "db:types:local": "supabase gen types typescript --remote=\"$TEST_DATABASE_URL\" --schema public > lib/db/types.ts && prettier --write lib/db/types.ts",
    "db:test": "bash supabase/tests/run.sh",
    "db:push": "supabase db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:osm": "tsx scripts/import-osm.ts",
    "e2e": "next build && playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.119.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "supercluster": "^9.1.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
