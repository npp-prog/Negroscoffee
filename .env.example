# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by the OpenStreetMap import script and to look up email addresses for
# notifications (admin pages use the signed-in admin). Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# maptiler.com → Account → Keys
NEXT_PUBLIC_MAPTILER_KEY=

# Public URL of the site (metadata, sitemap). Optional: "kapenegros.vercel.app" or a full https:// URL;
# when empty, Vercel's production URL is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Overpass endpoint for `npm run import:osm` (default https://overpass-api.de/api/interpreter)
# OVERPASS_URL=

# Optional: "on" if your Supabase plan includes Image Transformations (Pro). Photos are then
# served resized; otherwise the original (already browser-shrunk) files are used.
# NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=on

# Optional: public contact address on /privacy (any inbox you check, e.g. Gmail).
# NEXT_PUBLIC_CONTACT_EMAIL=

# Optional email notifications (resend.com → API Keys). Without RESEND_API_KEY no email is sent.
# Needs SUPABASE_SERVICE_ROLE_KEY too.
# RESEND_API_KEY=
# Sender; the default works only for your own Resend account email until you verify a domain.
# EMAIL_FROM=Kape Negros <hello@yourdomain.com>
# Who gets "new suggestion/claim" emails (comma-separated). Default: admins with emails on.
# NOTIFY_ADMIN_EMAILS=
# Where replies go (default: first NOTIFY_ADMIN_EMAILS address)
# EMAIL_REPLY_TO=
