# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by the OSM import script and admin actions. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# maptiler.com → Account → Keys
NEXT_PUBLIC_MAPTILER_KEY=

# Public URL of the site (used for metadata, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Overpass endpoint for `npm run import:osm` (default https://overpass-api.de/api/interpreter)
# OVERPASS_URL=
